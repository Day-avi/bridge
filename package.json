{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
