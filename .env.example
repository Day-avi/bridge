# Copy to .env.local for local development. Never commit real values.
# Local values come from `npx supabase status` after `npm run db:start`.

# --- Phase 0 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: leave empty to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Vercel build only (source map upload).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Later phases (not used yet) ---
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# TOKEN_ENCRYPTION_KEY=
# ANTHROPIC_API_KEY=
